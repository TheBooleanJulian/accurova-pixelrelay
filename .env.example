# PixelRelay configuration. Copy to .env for local use; set real values in the host's
# secret store in production. Nothing here is sent to the browser.

# development | production. Production refuses AUTH_MODE=dev, a short SECRET_KEY or a non-https BASE_URL.
APP_ENV=development

# Public origin, used for share links, invitation links and the Supabase redirect.
BASE_URL=http://localhost:8000

# Where the SQLite database and stored files live. Back this folder up.
DATA_DIR=data

# Long random secret (48+ chars). Derives Room PINs and keys the session/invite token hashes.
# Changing it changes every Room PIN and signs everyone out. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left empty in development, a random one is kept in DATA_DIR/.dev-secret.
SECRET_KEY=

# Owner sign-in: dev (any email, local only) | supabase (email magic link).
AUTH_MODE=dev
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Comma-separated emails allowed to sign in as owners. Empty = anyone who can sign in.
OWNER_EMAILS=

# File storage provider. Only "local" (files under DATA_DIR/files) exists today.
STORAGE_PROVIDER=local

# thread = run the image worker inside the web process. off = run `python -m pixelrelay.worker` separately.
WORKER_MODE=thread

# Upload limits.
MAX_UPLOAD_MB=80
MAX_IMAGE_MEGAPIXELS=120

# Set to 1 only behind a proxy you control (reads CF-Connecting-IP / X-Forwarded-For for rate limiting).
TRUST_PROXY=0

# Cookies get the Secure flag automatically when BASE_URL is https.
# COOKIE_SECURE=1

# Server bind (python -m pixelrelay).
HOST=127.0.0.1
PORT=8000
